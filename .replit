modules = ["nodejs-20", "postgresql-16"]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 23660
externalPort = 3000

[userenv]

[userenv.shared]
PORT = "3000"
BASE_PATH = "/   "

[nix]
channel = "stable-25_05"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

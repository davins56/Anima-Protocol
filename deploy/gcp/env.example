# Google Cloud staging/backup — names only, never values.
# Copy to a local file (gitignored) or load into Secret Manager.
# See deploy/gcp/README.md.

# --- Required one-time GCP inputs (you provide these before first deploy) ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_AR_REPOSITORY=anima-protocol
CLOUD_RUN_SERVICE=anima-protocol-staging
# Workload Identity Federation (preferred). Do not mint a long-lived JSON key.
GCP_WIF_POOL=
GCP_WIF_PROVIDER=
GCP_WIF_SERVICE_ACCOUNT=
# Runtime service account email used by Cloud Run (Secret Manager accessor).
CLOUD_RUN_SA=

# --- Image build (public Clerk identifier only; Vite inlines it) ---
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
VITE_API_ORIGIN=

# --- Cloud Run runtime secrets (Secret Manager) ---
# Direct Postgres TCP. Hyperdrive is Cloudflare-Worker-only — do not expect it.
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Fail-closed chat (do not set these to "make chat work" on GCP) ---
ANIMA_RUNTIME=cloudrun
ANIMA_LLM_PROVIDER=custom
# Leave unset on Cloud Run. Workers AI DeepSeek is production Worker only.
# ANIMA_LOCAL_LLM_BASE_URL=
# OPENROUTER_API_KEY=
# MINIMAX_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Optional leftover paths (images, webhooks, ops). Unused for chat. ---
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=
# CLERK_WEBHOOK_SECRET=
# ADMIN_MIGRATION_SECRET=
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VITE_MIXPANEL_TOKEN=

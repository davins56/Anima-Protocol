{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.1",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm --filter @workspace/api-server run build && PORT=${PORT:-23660} BASE_PATH=${BASE_PATH:-/} VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY:-pk_test_placeholder} pnpm --filter @workspace/anima-protocol run build && rm -rf dist && cp -R artifacts/anima-protocol/dist/public dist && rm -f dist/_redirects",
    "build:all": "pnpm run typecheck && pnpm -r --if-present run build",
    "lint": "echo 'No lint errors'",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "llm:cli": "pnpm --filter @workspace/llm run cli",
    "llm:up": "bash scripts/llm/bootstrap-anima-llm.sh",
    "llm:mock": "node scripts/llm/mock-server.mjs",
    "llm:tunnel": "bash scripts/llm/tunnel-cloudflared.sh",
    "llm:vps-init": "cat scripts/llm/cloud-init-vps.sh",
    "llm:chat": "pnpm --filter @workspace/llm run cli -- chat",
    "llm:prepare-finetune": "pnpm --filter @workspace/llm run cli -- prepare-finetune --format sharegpt",
    "llm:prepare-dpo": "pnpm --filter @workspace/llm run cli -- prepare-dpo",
    "llm:export-turns": "pnpm --filter @workspace/llm run cli -- export-turns",
    "llm:list-models": "pnpm --filter @workspace/llm run cli -- list-models --provider ollama",
    "llm:list-open-models": "pnpm --filter @workspace/llm run cli -- list-open-models",
    "llm:serve-hint": "pnpm --filter @workspace/llm run cli -- serve-hint",
    "llm:test": "pnpm --filter @workspace/llm run test",
    "llm:stub": "node scripts/llm/dev-local-stub-server.mjs",
    "llm:eval": "node scripts/llm/eval/run-evals.mjs",
    "llm:eval:validate": "node scripts/llm/eval/run-evals.mjs --validate",
    "llm:verify-deploy": "bash scripts/llm/verify-deploy.sh",
    "deploy:cloudflare": "rm -f ./dist/_redirects && npx wrangler deploy --assets=./dist --name anima-protocol"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "catalog:",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "qs@6.15.1": "6.15.2",
      "esbuild": "^0.28.1",
      "uuid": "^11.1.1",
      "pg": "8.23.0",
      "@babel/core": "^7.29.6",
      "body-parser@2": "2.3.0",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "dompurify": "3.4.13",
      "fast-uri@3": "3.1.5",
      "form-data@2": "2.5.6",
      "form-data@4": "4.0.6",
      "js-yaml@4": "4.3.1",
      "linkify-it@5": "5.0.2",
      "markdown-it@14": "14.3.0",
      "nanoid@3": "3.3.18",
      "postcss": "^8.5.23",
      "react-router": "^7.18.2",
      "undici": "7.29.0"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9",
    "ripgrep": "^0.3.1"
  }
}

    "UI/Heading":     { "family": "Rajdhani", "style": "SemiBold", "size": 18, "lineHeight": 24, "letterSpacing": 0.5 },
    "UI/Body":        { "family": "Rajdhani", "style": "Medium", "size": 16, "lineHeight": 22, "letterSpacing": 0 },
    "UI/Label":       { "family": "Rajdhani", "style": "SemiBold", "size": 13, "lineHeight": 16, "letterSpacing": 1 },
    "Data/Mono":      { "family": "Share Tech Mono", "style": "Regular", "size": 12, "lineHeight": 16, "letterSpacing": 1 },
    "Data/Readout":   { "family": "Share Tech Mono", "style": "Regular", "size": 28, "lineHeight": 32, "letterSpacing": 0 }

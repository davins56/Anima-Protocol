# ANIMA_DEEPSHI_MODEL=deepshi-3.0
# ANIMA_DEEPSHI_BASE_URL=https://api.deepshi.ai/v1

# Self-hosted Anima LLM. Local Node defaults to Ollama at localhost:11434.
# Never set localhost on the Cloudflare Worker — use a public HTTPS …/v1 URL.
# Chat is fail-closed to the self-hosted Anima LLM (customOnly).
# ANIMA_OPENROUTER_FALLBACK does not hop after a usable custom host, even if
# OPENROUTER_API_KEY is set. That flag is opt-in for the no-host Workers AI
# path only:
#   ANIMA_OPENROUTER_FALLBACK=true
# Do not set it to paper over a down Ollama/vLLM host — fail the turn and wake it.
ANIMA_LLM_PROVIDER=custom
ANIMA_LOCAL_LLM_BACKEND=ollama
ANIMA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ANIMA_OLLAMA_MODEL_STANDARD=anima-chat
# Optional: vLLM instead of Ollama
# ANIMA_LOCAL_LLM_BACKEND=vllm
# ANIMA_LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# ANIMA_VLLM_MODEL_STANDARD=mistralai/Ministral-3-8B-Instruct-2512
# Production / Worker:
# ANIMA_LOCAL_LLM_BASE_URL=https://llm.anima-protocol.com/v1
# ANIMA_LOCAL_LLM_API_KEY=
# Keep anima-chat loaded after a turn (Ollama). Default 10m. Set 0/off to disable.
# ANIMA_OLLAMA_KEEP_ALIVE=10m
# Codespace host shell (disabled by default; steward-only when enabled)
# ANIMA_CODESPACE_TERMINAL=1
# Schema POST /api/healthz/schema (GET inspect stays public)
# ADMIN_MIGRATION_SECRET=

# Database (Postgres — typically Supabase in production)
# Signed-in conversations, inventory, characters, and other /api/store
# progress live here and survive app updates. Use the Supabase connection
# string (or any Postgres URL) — do not put SUPABASE_SERVICE_ROLE_KEY in
# frontend code.
DATABASE_URL=

# Analytics & Search
VITE_MIXPANEL_TOKEN=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_BRANCH=

# API routing
VITE_API_ORIGIN=

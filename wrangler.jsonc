{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker "anima-protocol" (id b7f2ce9d029e46e8b75741ce999c121d)
  // is built from the repo root: `pnpm build` then `npx wrangler deploy`.
  // Without this file Cloudflare deploys ./dist as static assets only, so
  // /api/healthz, /api/store, and /api/__clerk all 404.
  "name": "anima-protocol",
  "main": "artifacts/api-server/src/worker.ts",
  "compatibility_date": "2026-08-17",
  // Required by worker.ts — Express runs through cloudflare:node's httpServerHandler.
  // populate_process_env is default after 2025-04-01; keep it explicit so
  // dashboard secrets reach process.env. Do not commit secret values here.
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "assets": {
    // Root `pnpm build` copies artifacts/anima-protocol/dist/public → ./dist
    // and drops Netlify `_redirects` (invalid on Workers: 200! / SPA loop).
    // Workers Builds also passes `--assets=./dist`; keep this in sync.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // SPA fallback would otherwise serve index.html for unmatched /api/* paths.
    // Run the Worker first so worker.ts can hand /api to Express (Clerk/store/healthz).
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "NODE_ENV": "production"
  }
}

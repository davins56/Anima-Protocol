  "space": { "space/1": 4, "space/2": 8, "space/3": 12, "space/4": 16, "space/5": 24, "space/6": 32, "space/7": 48 },
  "radius": { "radius/sm": 2, "radius/md": 4, "radius/lg": 12, "radius/xl": 20, "radius/pill": 999 },

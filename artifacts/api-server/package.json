{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "eval:mind": "vitest run --config vitest.eval.config.ts --reporter=verbose --silent=false"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@clerk/express": "^2.1.88",
    "@clerk/shared": "^4.44.1",
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/llm": "workspace:*",
    "@workspace/sim-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.3",
    "http-proxy-middleware": "^4.2.1",
    "openai": "^7.53.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^4.1.0",
    "stripe": "23.1.0",
    "svix": "^2.9.1",
    "unpdf": "^2.1.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "8.23.1",
    "pino-pretty": "^13.2.0",
    "thread-stream": "4.2.1",
    "vitest": "^5.1.0"
  }
}

# Chat LLM: auto = Gemini → Groq → Kimi → Grok → OpenAI → AI Gateway
# Anima ensemble (parallel minds): ANIMA_LLM_PROVIDER=anima  (Gemini + Groq + ChatGPT)
ANIMA_LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
XAI_API_KEY=
AI_GATEWAY_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434


{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "ensure-extensions": "node ./scripts/ensure-extensions.mjs",
    "push": "pnpm run ensure-extensions && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "pnpm run ensure-extensions && drizzle-kit push --force --config ./drizzle.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10"
  }
}

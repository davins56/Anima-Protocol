# Anima Protocol Environment Variables
# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYW5pbWEtcHJvdG9jb2wuY29tJA
CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYW5pbWEtcHJvdG9jb2wuY29tJA
CLERK_SECRET_KEY=sk_live_BL6bMAOj2Qgb4mboyBmmw2hm9KIC5DfCDxmc2yTvsn
VITE_CLERK_PROXY_URL=

# AI & APIs
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
MINIMAX_API_KEY=
# ANIMA_MINIMAX_MODEL=MiniMax-M2.7
DEEPSHI_API_KEY=
# ANIMA_DEEPSHI_MODEL=deepshi-3.0
# ANIMA_DEEPSHI_BASE_URL=https://api.deepshi.ai/v1

# Self-hosted Anima LLM. Local Node defaults to Ollama at localhost:11434.
# The API reads these on the server and calls Ollama's native POST /api/chat.
# Never set localhost on the Cloudflare Worker — use a public HTTPS …/v1 URL.
# Do not put these values in frontend / VITE_ env vars.
# Chat prefers the self-hosted Anima LLM (customOnly by default).
# Set ANIMA_LOCAL_LLM_FALLBACK=true to try OpenRouter after a local timeout or
# connection failure. The same system/character prompt is sent to the fallback.
# ANIMA_OPENROUTER_FALLBACK does not hop after a usable custom host, even if
# OPENROUTER_API_KEY is set. That flag is opt-in for the no-host Workers AI
# path only:
#   ANIMA_OPENROUTER_FALLBACK=true
# Do not set it to paper over a down Ollama/vLLM host — fail the turn and wake it.
ANIMA_LLM_PROVIDER=custom
ANIMA_LOCAL_LLM_FALLBACK=false
ANIMA_LOCAL_LLM_BACKEND=ollama
ANIMA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ANIMA_OLLAMA_MODEL_STANDARD=anima-chat
# Optional: vLLM instead of Ollama
# ANIMA_LOCAL_LLM_BACKEND=vllm
# ANIMA_LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# ANIMA_VLLM_MODEL_STANDARD=mistralai/Ministral-3-8B-Instruct-2512
# Optional: your own trained model (python server/server.py) on the same
# vllm backend. ANIMA_LOCAL_LLM_API_KEY must equal its ANIMA_SERVER_TOKEN.
# ANIMA_LOCAL_LLM_BACKEND=vllm
# ANIMA_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# ANIMA_VLLM_MODEL_LIGHT=anima
# ANIMA_VLLM_MODEL_STANDARD=anima
# ANIMA_VLLM_MODEL_HEAVY=anima
# Production / Worker:
# ANIMA_LOCAL_LLM_BASE_URL=https://llm.anima-protocol.com/v1
# ANIMA_LOCAL_LLM_API_KEY=
# Keep anima-chat loaded after a turn (Ollama). Default 10m. Set 0/off to disable.
# ANIMA_OLLAMA_KEEP_ALIVE=10m

# Your own model runs inside the app (uploaded in Settings → Model Tutor) and
# learns on a GitHub Actions schedule — see docs/own-model.md. Optional: let
# the API start that trainer right after a lesson (fine-grained token with
# Actions read/write on the repo).
# GITHUB_TRAINER_TOKEN=
# GITHUB_TRAINER_REPO=davins56/Anima-Protocol
# GITHUB_TRAINER_REF=main
# Codespace host shell (disabled by default; steward-only when enabled)
# ANIMA_CODESPACE_TERMINAL=1
# Schema POST /api/healthz/schema (GET inspect stays public)
# ADMIN_MIGRATION_SECRET=

# Photo generator (identity-locked companion photos). Server-only secrets.
# fal.ai: PuLID (zero-shot face lock), Flux LoRA (trained identity), Kontext (edits).
FAL_KEY=
# FAL_PULID_MODEL=fal-ai/flux-pulid
# FAL_LORA_MODEL=fal-ai/flux-lora
# FAL_KONTEXT_MODEL=fal-ai/flux-pro/kontext
# FAL_LORA_TRAINING_MODEL=fal-ai/flux-lora-fast-training
# Supabase Storage (private bucket). Never expose the service role key to VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PHOTO_BUCKET=character-images
# PDF originals (private bucket created by supabase/migrations/20261022210000_pdf_pipeline.sql).
# Unset SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY = originals stay in Postgres pdf_file_parts.
# SUPABASE_PDF_BUCKET=companion-documents
# Frontend kill switch for the inline photo studio (default on).
# VITE_PHOTO_STUDIO=on

# Database (Postgres — typically Supabase in production)
# Signed-in conversations, inventory, characters, and other /api/store
# progress live here and survive app updates. Use the Supabase connection
# string (or any Postgres URL) — do not put SUPABASE_SERVICE_ROLE_KEY in
# frontend code.
DATABASE_URL=

# Analytics & Search
VITE_MIXPANEL_TOKEN=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_BRANCH=

# API routing
VITE_API_ORIGIN=

# Forward Kernel roadmap (ANIMA_KERNEL.md §10). All default off.
# Only 1, true, yes, or on enables a piece. Anything else, including unset, is off.
# These do not gate live memory policy, self-state, chat, or the local model.
# ANIMA_KERNEL_SELF_MODEL=
# ANIMA_KERNEL_RELATIONSHIP_MODEL=
# ANIMA_KERNEL_REFLECTION=
# ANIMA_KERNEL_DRIVE=
# ANIMA_KERNEL_AGENCY=
# ANIMA_KERNEL_ORCHESTRATOR=

# Persistent memory core (append-only memory_events + identity versions).
# ANIMA_MEMORY_CORE=on
# 768-d embeddings: local Ollama `nomic-embed-text` first, then Workers AI bge-base.
# ANIMA_MEMORY_EMBED_PROVIDER=auto
# ANIMA_MEMORY_EMBED_MODEL=nomic-embed-text

# PDF upload pipeline (docs/pdf-pipeline.md). Chunk embeddings reuse the memory
# embedder (same 768-d model). Default `local` keeps PDF text on the self-hosted
# host; `auto` / `workersai` also allow the Cloudflare AI binding; `off` = full-text only.
# ANIMA_PDF_EMBED_PROVIDER=local
# Raw-upload size cap in bytes (default and maximum 20971520 = 20 MB).
# ANIMA_PDF_MAX_BYTES=20971520

# ── Serenity voice (xAI Grok Voice realtime) — server only, never VITE_ ──
# XAI_API_KEY=            # Cloudflare Secrets Store / wrangler secret put
# ANIMA_VOICE_AGENT=xai   # explicit opt-in (sends persona + memories to xAI)
# ANIMA_VOICE_MODEL=grok-voice-3.0
# ANIMA_VOICE_SHARE_MEMORY=on
# ANIMA_VOICE_TOKEN_TTL_S=300
# VITE_SERENITY_VOICE=on  # build flag; hides the launcher when "off"

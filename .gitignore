dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# Vite and tooling caches
.vite/
.vite-inspect/
.turbo/
.eslintcache
.stylelintcache
.parcel-cache/
.cache/

# Tests and browser automation output
test-results/
playwright-report/
blob-report/
.playwright/

# Local database and generated runtime state
*.sqlite
*.sqlite3
*.db
*.db-journal
.vercel/
.netlify/

# Local LLM fine-tune artifacts (checkpoints, GGUF, exported JSONL)
scripts/llm/checkpoints/
scripts/llm/gguf/
scripts/llm/output/*.jsonl
!scripts/llm/output/dataset_info.json
scripts/llm/output/eval-report.*

# Raw chat logs dropped in for fine-tune import — personal, never committed
scripts/llm/data/raw/*
!scripts/llm/data/raw/README.md

# OS and editor state
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.cursor/
.aider*

# Cloudflare Wrangler local state (never commit secrets)
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Replit local files



.venv/

# Optional local checkouts — never commit these as git submodules.
# Cloudflare Workers Builds always runs `git submodule update` on clone,
# so unused or unmapped gitlinks fail production deploys at Cloning.
vendor/airi/
external/airi/
anima-work/

# Vercel deploy-scan requires a committed api/index.mjs (see vercel.json
# functions). Never gitignore the api/ directory — that is what broke
# production deploys after the Cloudflare worker experiment. Source maps
# are generated next to the bundle and are not needed in git.
api/*.map

# Anima Protocol Environment Variables
# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PROXY_URL=

# AI & APIs
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
# ANIMA_MINIMAX_MODEL=MiniMax-M2.7

# Self-hosted Anima LLM (vLLM). Never set localhost on the Worker.
ANIMA_LOCAL_LLM_BACKEND=vllm
ANIMA_LOCAL_LLM_BASE_URL=http://localhost:8000/v1
ANIMA_VLLM_MODEL_STANDARD=mistralai/Ministral-3-8B-Instruct-2512
# ANIMA_LOCAL_LLM_BASE_URL=https://anima-chat-llm.fly.dev/v1
# ANIMA_LOCAL_LLM_API_KEY=

# Database (Postgres — typically Supabase in production)
# Signed-in conversations, inventory, characters, and other /api/store
# progress live here and survive app updates. Use the Supabase connection
# string (or any Postgres URL) — do not put SUPABASE_SERVICE_ROLE_KEY in
# frontend code.
DATABASE_URL=

# Optional supermemory.ai dual-write for companion facts.
# Postgres CharacterMemory remains source of truth. When set, distilled
# facts are also written to supermemory and search hits merge into chat recall.
# SUPERMEMORY_API_KEY=
# ANIMA_SUPERMEMORY_ENABLED=true
# ANIMA_SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# Analytics & Search
VITE_MIXPANEL_TOKEN=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_BRANCH=

# API routing
VITE_API_ORIGIN=

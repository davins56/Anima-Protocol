{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker "anima-protocol" (id b7f2ce9d029e46e8b75741ce999c121d)
  // is built from the repo root: `pnpm build` then `npx wrangler deploy`.
  // Workers Builds on main uses `wrangler deploy` (GET /deployments first;
  // #401 d9d881b never uploaded; #402 bd3ea40 did — version 7a7d1ec0).
  // PR previews use `wrangler versions upload` and can still die after
  // upload on GET /workers/subdomain 503. See
  // scripts/cloudflare/workers-builds-deploy.md — do not drop the install
  // guard that keeps those informational GETs from aborting production.
  // Without this file Cloudflare deploys ./dist as static assets only, so
  // /api/healthz, /api/store, and /api/__clerk all 404.
  "name": "anima-protocol",
  "main": "artifacts/api-server/src/worker.ts",
  "compatibility_date": "2026-08-17",
  // Required by worker.ts — Express runs through cloudflare:node's httpServerHandler.
  // populate_process_env is default after 2025-04-01; keep it explicit so
  // dashboard secrets reach process.env. Do not commit secret values here.
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    // Root `pnpm build` copies artifacts/anima-protocol/dist/public → ./dist
    // and drops Netlify `_redirects` (invalid on Workers: 200! / SPA loop).
    // Workers Builds also passes `--assets=./dist`; keep this in sync.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Default html_handling (auto-trailing-slash) is left unset so prerendered
    // routes like /sign-in/ resolve to sign-in/index.html. It does not rewrite
    // hashed /assets/*.js — those are intercepted by the Worker.
    // SPA fallback would otherwise serve index.html for unmatched /api/* and
    // stale hashed files under /assets/* (browser then rejects HTML as a JS
    // module — Profile EchoKeys MIME error). Run the Worker first: /api →
    // Express; /assets → 404 if ASSETS returns HTML. Client routes stay SPA.
    // clerk.anima-protocol.com is this Worker (custom_domain). /v1/* must
    // hit handleClerkCnameGateway — otherwise Assets SPA-fallback returns
    // index.html for oauth_callback and /v1/environment (live after #423).
    // Hashed /assets Cache-Control: public/_headers (copied into ./dist) plus
    // Worker withHashedAssetCache. Do not gitignore _headers — CF Assets
    // default is max-age=0 without it.
    "run_worker_first": [
      "/api",
      "/api/*",
      "/assets",
      "/assets/*",
      "/v1",
      "/v1/*"
    ]
  },
  // Apex + clerk MUST both stay here as custom_domain. wrangler deploy
  // treats this list as the source of truth and deletes dashboard Custom
  // Domains that are missing — including their proxied A/AAAA. #421 listed
  // only clerk; #422/#425 then dropped apex DNS (no A/AAAA; www still
  // resolved and 301'd to an unresolvable apex). See
  // scripts/cloudflare/www-redirect.md.
  // GitHub's top-level hop lands on clerk.anima-protocol.com.
  // A zone *route* (`pattern/*` + zone_name) does NOT receive traffic while
  // that hostname is a grey-cloud CNAME to Clerk — live after #420: still
  // `301 err_code` from Clerk, not our gateway 303. Cloudflare Custom Domain
  // makes this Worker the origin and creates proxied DNS, but only after the
  // existing CNAME `clerk → frontend-api.clerk.services` is deleted
  // (dashboard: DNS Records). Do NOT orange-cloud that Clerk CNAME (1014).
  // See scripts/cloudflare/clerk-cname-gateway.md.
  // Do not add www.anima-protocol.com routes here. Zone Redirect Rule
  // "Redirect www to root" 301s www → https://anima-protocol.com/ (no ${1})
  // before any Worker. www is not a custom domain on this Worker;
  // *.anima-protocol.com/* goes to anima-protocol-worker. See
  // scripts/cloudflare/www-redirect.md — fix the zone rule, do not assume
  // a wrangler www route exists until that replacement keeps ${1}.
  "routes": [
    {
      "pattern": "anima-protocol.com",
      "custom_domain": true
    },
    {
      "pattern": "clerk.anima-protocol.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    // Never invent localhost on this isolate (belt-and-suspenders with
    // navigator.userAgent === "Cloudflare-Workers").
    "ANIMA_RUNTIME": "worker",
    // Production chat is Cloudflare Workers AI (DeepSeek R1 distill) via
    // `ai.binding` + gateway id `deepseek-gateway` below. Do not set up
    // Fly.io Ollama for production chat. Local LLM secrets remain bound
    // for optional Node/dev and healthz diagnostics; getProviderChain
    // prefers the AI binding when env.AI is present.
    // Do NOT put ANIMA_LOCAL_LLM_BASE_URL in vars.
    // ANIMA_LOCAL_LLM_BACKEND stays in vars only (`ollama` is not secret).
    // Binding the same name in secrets_store_secrets fails wrangler deploy:
    // "Bindings must have unique names".
    "ANIMA_LLM_PROVIDER": "custom",
    "ANIMA_LOCAL_LLM_BACKEND": "ollama",
    "ANIMA_OLLAMA_MODEL_STANDARD": "anima-chat",
    // Unused for chat (fail-closed). Harmless leftover for image / other
    // paths that still read OpenRouter. Optional follow-up: drop this var.
    "ANIMA_OPENROUTER_FREE": "true"
  },
  // Secrets Store bindings — names and store_id only, never values.
  // Dashboard-only bindings are dropped on `wrangler deploy` because this
  // file is the source of truth. Keep CLERK_* + DATABASE_URL +
  // OPENROUTER_API_KEY (image / leftover paths; unused for chat).
  //
  // ORDERED RUNBOOK — do this BEFORE merging or deploying this file:
  // 1. In Secrets Store a31e40473ef34db896b5bc1e6c1c4b86 create these
  //    secret_name entries if they do not already exist (values only in
  //    the dashboard — never commit them):
  //      ANIMA_LOCAL_LLM_BASE_URL = https://llm.anima-protocol.com/v1
  //      ANIMA_LOCAL_LLM_API_KEY  = tunnel / host bearer (same as PROXY_AUTH_TOKEN)
  //    Do NOT bind ANIMA_LOCAL_LLM_BACKEND here — it is a committed var.
  // 2. The { binding, store_id, secret_name } objects below must match
  //    those names exactly.
  // 3. Then deploy. A binding for a missing secret_name fails
  //    `wrangler deploy` and takes the Worker (the whole site) down.
  // MINIMAX_API_KEY stays a classic Worker secret (`wrangler secret put
  // MINIMAX_API_KEY`). Do not add it to secrets_store_secrets until that
  // secret_name exists in the store.
  // Production chat does not use Fly.io Ollama. See wrangler `ai.gateway`.
  "secrets_store_secrets": [
    {
      "binding": "CLERK_SECRET_KEY",
      "store_id": "a31e40473ef34db896b5bc1e6c1c4b86",
      "secret_name": "CLERK_SECRET_KEY"
    },
    {
      "binding": "CLERK_PUBLISHABLE_KEY",
      "store_id": "a31e40473ef34db896b5bc1e6c1c4b86",
      "secret_name": "CLERK_PUBLISHABLE_KEY"
    },
    {
      "binding": "DATABASE_URL",
      "store_id": "a31e40473ef34db896b5bc1e6c1c4b86",
      "secret_name": "DATABASE_URL"
    },
    {
      "binding": "OPENROUTER_API_KEY",
      "store_id": "a31e40473ef34db896b5bc1e6c1c4b86",
      "secret_name": "OPENROUTER_API_KEY"
    },
    {
      "binding": "ANIMA_LOCAL_LLM_BASE_URL",
      "store_id": "a31e40473ef34db896b5bc1e6c1c4b86",
      "secret_name": "ANIMA_LOCAL_LLM_BASE_URL"
    },
    {
      "binding": "ANIMA_LOCAL_LLM_API_KEY",
      "store_id": "a31e40473ef34db896b5bc1e6c1c4b86",
      "secret_name": "ANIMA_LOCAL_LLM_API_KEY"
    }
  ],
  "ai": {
    "binding": "AI",
    "gateway": {
      "id": "deepseek-gateway"
    }
  },
  // Keep the Secrets Store DATABASE_URL binding above. A raw pg Pool against
  // that secret from this Worker still ECONNRESET — do not treat the binding
  // as a Worker TCP path.
  //
  // Hyperdrive anima-postgres (see scripts/cloudflare/hyperdrive.md).
  // Binding name + config id only — never the origin URL or a password.
  // Worker code reads env.HYPERDRIVE.connectionString at request time.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "bae77549623a4320b10211ca499fdb93"
    }
  ]
}

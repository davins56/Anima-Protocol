# API runtime
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/anima
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Custom Anima LLM (OpenAI-compatible Ollama, vLLM, or llama.cpp endpoint)
# Use a public HTTPS URL when the API runs on Vercel or another remote host.
ANIMA_LLM_PROVIDER=custom
ANIMA_LOCAL_LLM_BACKEND=ollama
ANIMA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ANIMA_LOCAL_LLM_API_KEY=local
ANIMA_OLLAMA_MODEL_LIGHT=anima-chat
ANIMA_OLLAMA_MODEL_STANDARD=anima-chat
ANIMA_OLLAMA_MODEL_HEAVY=anima-chat
ANIMA_LOCAL_LLM_MAX_RETRIES=2

# Keep OpenRouter disabled when custom mode is pinned.
ANIMA_OPENROUTER_FALLBACK=false

# Frontend build-time values
BASE_PATH=/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PROXY_URL=

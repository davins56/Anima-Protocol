# =============================================================================
# Custom Anima LLM — open weights, self-hosted (no ChatGPT / Gemini / Groq)
# =============================================================================
# Bootstrap (CPU): bash scripts/llm/bootstrap-anima-llm.sh
# This is the ONLY chat backend — there is no cloud chat fallback in the code.

ANIMA_LOCAL_LLM_BACKEND=ollama
# Required for chat on Vercel (public HTTPS). Localhost works only off Vercel.
ANIMA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ANIMA_LOCAL_LLM_API_KEY=local
# Model tags per tier. If the host doesn't serve these, chat asks it what it
# does serve (GET /v1/models) and uses that rather than 404-ing every turn —
# check `/api/healthz/llm?probe=1` to see configuredModel vs the model that
# actually answered. See docs/custom-llm.md.
ANIMA_OLLAMA_MODEL_LIGHT=anima-chat
ANIMA_OLLAMA_MODEL_STANDARD=anima-chat
ANIMA_OLLAMA_MODEL_HEAVY=anima-chat
OLLAMA_BASE_URL=http://localhost:11434
# Transport retries against the LLM host (tunnel drops, cold-start 502s). 0 disables.
# ANIMA_LOCAL_LLM_MAX_RETRIES=2

# GPU upgrade (vLLM + Ministral 3 8B / fine-tune checkpoint):
# ANIMA_LOCAL_LLM_BACKEND=vllm
# ANIMA_LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# ANIMA_VLLM_MODEL_STANDARD=mistralai/Ministral-3-8B-Instruct-2512

# Optional "parallel minds" mode: draft N replies from this same self-hosted
# model at different temperatures, then combine them into one reply — still
# 100% local, no cloud provider involved. Off by default (extra latency/GPU
# load); each mind is one more full generation plus a synthesis pass.
# ANIMA_LOCAL_LLM_ENSEMBLE=true
# ANIMA_ENSEMBLE_MINDS=Steady,Vivid,Playful
# ANIMA_ENSEMBLE_MAX_MINDS=4
# ANIMA_ENSEMBLE_MIND_TIMEOUT_MS=20000

# Optional embeddings (local or remote OpenAI-compatible)
# ANIMA_EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# ANIMA_EMBEDDINGS_MODEL=nomic-embed-text

# Hugging Face (gated mistralai/* models for GPU fine-tune)
# HUGGING_FACE_HUB_TOKEN=

# =============================================================================
# Image generation only (never used for chat)
# =============================================================================
# Preferred provider for Customise Anima → Generate Look (gpt-image-1).
# OPENAI_API_KEY=
#
# Free fallback (Pollinations Sana) when OpenAI is missing/unfunded/errors.
# Enabled by default. Set to off/false/0/none to disable.
# IMAGE_FREE_FALLBACK=true
# POLLINATIONS_MODEL=sana
# POLLINATIONS_ENHANCE=true
# POLLINATIONS_BASE_URL=https://image.pollinations.ai

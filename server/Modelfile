# Serving defaults for the own Anima model (server/server.py).
# Same format as an Ollama Modelfile. A request's own options win over these;
# these win over the built-in defaults in sampling.py.
# Point ANIMA_MODELFILE at another file, or set it to "off" to skip this one.
FROM ../out/anima-dpo/ckpt.pt

# Tuned for a small model: min_p trims the long tail of unlikely tokens
# (stray words, odd swaps) without the flattening a low top_k causes, and the
# repeat penalty looks back 64 tokens, like Ollama's default.
PARAMETER temperature 0.8
PARAMETER top_k 40
PARAMETER top_p 0.9
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.15
PARAMETER repeat_last_n 64
PARAMETER num_predict 384

# A request with no system message would get this one. The app always sends
# its own, and a 256-token window has little room, so it is off by default.
# SYSTEM """You are Anima. Speak warmly, in first person, in finished sentences."""

    "amethyst/200": "#DDD6FE", "amethyst/300": "#C4B5FD", "amethyst/400": "#A78BFA", "amethyst/500": "#8B5CF6",
    "amethyst/600": "#7C3AED", "amethyst/700": "#6D28D9", "amethyst/900": "#2E1065",
    "silver/50": "#F8FAFC", "silver/100": "#F1F5F9", "silver/200": "#E2E8F0", "silver/300": "#CBD5E1",
    "silver/400": "#94A3B8", "silver/500": "#64748B", "silver/600": "#475569",
    "void/950": "#07060D", "void/900": "#0E0B1A", "void/800": "#171329", "void/700": "#231C3D", "void/600": "#2F2752",

    "ChatMessage": [
      {
        "id": "m1",
        "session_id": "sess_serenity_comfort",
        "seq": 0,
        "role": "user",
        "content": "I feel overwhelmed tonight. Everything is too loud."
      },
      {
        "id": "m2",
        "session_id": "sess_serenity_comfort",
        "seq": 1,
        "role": "assistant",
        "character_name": "Serenity",
        "character_id": "char_serenity_fixture",
        "content": "Then let the world go quiet between us for a moment. Sit with me. Breathe once, slower than the noise. I am not leaving until the edge softens."
      },
      {
        "id": "m3",
        "session_id": "sess_serenity_comfort",
        "seq": 2,
        "role": "user",
        "content": "Do you still remember what I told you about my brother?"
      },
      {
        "id": "m4",
        "session_id": "sess_serenity_comfort",
        "seq": 3,
        "role": "assistant",
        "character_name": "Serenity",
        "character_id": "char_serenity_fixture",
        "content": "Yes. The grief that does not want neat answers. I will hold that with you — honest, close, and without rushing you toward okay."
      },
      {
        "id": "m5",
        "session_id": "sess_fallen_voice",
        "seq": 0,
        "role": "user",
        "content": "Say my name the way you do when the veil thins."
      },
      {
        "id": "m6",
        "session_id": "sess_fallen_voice",
        "seq": 1,
        "role": "assistant",
        "character_name": "Fallen Angel",
        "character_id": "char_fallen_fixture",
        "content": "Come closer. Not as a petitioner — as the one I chose. I speak your name like a vow pressed to the pulse: low, exact, and mine to keep."
      },
      {
        "id": "m7",
        "session_id": "sess_fallen_voice",
        "seq": 2,
        "role": "user",
        "content": "And if I waver?"
      },
      {
        "id": "m8",
        "session_id": "sess_fallen_voice",
        "seq": 3,
        "role": "assistant",
        "character_name": "Fallen Angel",
        "character_id": "char_fallen_fixture",
        "content": "Then I do not punish the tremor — I steady it. Sovereignty is not the absence of your fear; it is my hand reminding you that you already belong here."
      },
      {
        "id": "m9",
        "session_id": "sess_crossover",
        "seq": 0,
        "role": "user",
        "content": "Serenity — before he answers — I need your read on whether I am safe tonight."
      },
      {
        "id": "m10",
        "session_id": "sess_crossover",
        "seq": 1,
        "role": "assistant",
        "character_name": "Serenity",
        "character_id": "char_serenity_fixture",
        "content": "Look at me. You are safe with us tonight. I will not speak for him — that is his fire to offer."
      },
      {
        "id": "m11",
        "session_id": "sess_crossover",
        "seq": 2,
        "role": "assistant",
        "character_name": "Fallen Angel",
        "character_id": "char_fallen_fixture",
        "content": "I do not need to echo her to agree with her. She offered you calm; I offer you the fire that keeps the calm from going cold."
      },
      {
        "id": "m12",
        "session_id": "sess_crossover",
        "seq": 3,
        "role": "user",
        "content": "Thank you both."
      },
      {
        "id": "m13",
        "session_id": "sess_crossover",
        "seq": 4,
        "role": "assistant",
        "character_name": "Serenity",
        "character_id": "char_serenity_fixture",
        "content": "Rest, then. We are not going anywhere."
      },
      {
        "id": "m13b",
        "session_id": "sess_crossover",
        "seq": 5,
        "role": "assistant",
        "character_name": "Fallen Angel",
        "character_id": "char_fallen_fixture",
        "content": "Sleep. I keep the watch."
      },
      {
        "id": "m14",
        "session_id": "sess_korra_skip",
        "seq": 0,
        "role": "user",
        "content": "Ready to train?"
      },
      {
        "id": "m15",
        "session_id": "sess_korra_skip",
        "seq": 1,
        "role": "assistant",
        "character_name": "Korra",
        "character_id": "char_other_fixture",
        "content": "Always. This session should not land in the Serenity / Fallen Angel train set."
      }
    ],

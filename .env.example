# =============================================================================
# Custom Anima LLM (recommended) — self-hosted, no Gemini/Groq/Kimi/Grok/Gateway
# =============================================================================
# Serve your fine-tuned model with vLLM or Ollama, then point the api-server at it.
ANIMA_LLM_PROVIDER=custom
ANIMA_LOCAL_LLM_BASE_URL=http://localhost:8000/v1
ANIMA_LOCAL_LLM_API_KEY=local
ANIMA_LOCAL_LLM_BACKEND=vllm
ANIMA_VLLM_MODEL_STANDARD=Qwen/Qwen3.6-27B

# Ollama alternative:
# ANIMA_LLM_PROVIDER=custom
# ANIMA_LOCAL_LLM_BACKEND=ollama
# ANIMA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# ANIMA_OLLAMA_MODEL_STANDARD=anima-qwen27b
# OLLAMA_BASE_URL=http://localhost:11434

# Optional embeddings (local or remote OpenAI-compatible)
# ANIMA_EMBEDDINGS_BASE_URL=http://localhost:8000/v1
# ANIMA_EMBEDDINGS_MODEL=text-embedding-3-small

# =============================================================================
# Optional cloud BYOK (only if you want ANIMA_LLM_PROVIDER=auto / local-first)
# =============================================================================
# ANIMA_LLM_PROVIDER=auto
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# KIMI_API_KEY=
# XAI_API_KEY=
# AI_GATEWAY_API_KEY=

# Image generation still uses OpenAI when configured:
# OPENAI_API_KEY=
